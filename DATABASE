-- 1. Setup Database
SET FOREIGN_KEY_CHECKS = 0;
DROP DATABASE IF EXISTS tnts_library_db;
CREATE DATABASE tnts_library_db;
USE tnts_library_db;
SET FOREIGN_KEY_CHECKS = 1;

-- 2. Admin/Librarian Credentials
CREATE TABLE tb_Credentials (
    UserID INT PRIMARY KEY AUTO_INCREMENT,
    Email VARCHAR(100) NOT NULL UNIQUE,
    Password VARCHAR(255) NOT NULL,
    Role VARCHAR(50) DEFAULT 'Librarian'
);

-- 3. Student Signup Table (The "Unverified" data)
CREATE TABLE tb_StudentCredentials (
    StudentID VARCHAR(50) PRIMARY KEY, -- LRN
    FirstName VARCHAR(100) NOT NULL,
    LastName VARCHAR(100) NOT NULL,
    Gmail VARCHAR(255) NOT NULL UNIQUE, -- Unique Gmail as requested
    Password VARCHAR(255) NOT NULL,
    Role VARCHAR(20) DEFAULT 'student',
    CreatedAt TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

-- 4. Official Student Registry (The "Verified" data)
CREATE TABLE students (
    student_id VARCHAR(50) PRIMARY KEY, -- Matches tb_StudentCredentials StudentID
    first_name VARCHAR(100) NOT NULL,
    last_name VARCHAR(100) NOT NULL,
    grade_level INT,
    strand VARCHAR(50),
    section VARCHAR(50),
    adviser VARCHAR(100),
    contact_number VARCHAR(20),
    email VARCHAR(100) NOT NULL UNIQUE
);

-- 5. Book Inventory
CREATE TABLE books (
    id INT PRIMARY KEY AUTO_INCREMENT,
    isbn VARCHAR(20) NOT NULL UNIQUE,        
    title VARCHAR(255) NOT NULL,
    author VARCHAR(255) NOT NULL,
    genre VARCHAR(50),
    stocks INT DEFAULT 1,
    format VARCHAR(50),
    location VARCHAR(50),
    status VARCHAR(50) DEFAULT 'Available',
    image VARCHAR(255) DEFAULT NULL
);

-- 6. Borrowing Transactions
CREATE TABLE borrowers (
    id INT AUTO_INCREMENT PRIMARY KEY,
    student_id VARCHAR(50) NOT NULL,
    book_id INT NOT NULL,
    book_borrowed VARCHAR(255) NOT NULL,
    date_borrowed DATETIME DEFAULT CURRENT_TIMESTAMP,
    due_date DATE NOT NULL,
    return_date DATETIME NULL,
    status ENUM('Borrowed', 'Returned') DEFAULT 'Borrowed',
    INDEX (student_id),
    INDEX (book_id)
) ENGINE=InnoDB;

-- 7. Reports
CREATE TABLE reports (
    id INT PRIMARY KEY AUTO_INCREMENT,
    report_title VARCHAR(255),
    total_transactions INT,
    report_summary TEXT,
    generated_date TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

